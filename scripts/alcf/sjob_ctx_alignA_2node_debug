#!/bin/bash -l
#PBS -A lighthouse-purdue
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -N ctxA_dbg
#PBS -k doe
#PBS -j oe
#
# X9 (Stage-A projector alignment, ContextProjectorAlign_JEPA) -- 2-node,
# all-8-GPU debug smoke test on Polaris.
#
# The `debug` queue caps walltime at 1h (see POLARIS.md), so this run will
# NOT finish the real ~58h/20K-step Stage-A job -- it exists to confirm the
# 2-node x 4-GPU multi-node launch is wired correctly, that all 8 GPUs are
# actually busy (not just allocated), and that the per-GPU batch size fits
# in 40GB, before committing this to `preemptable`/`capacity` for the full run.
#
# Uses checkpoints/reFlux/ContextProjectorAlign_JEPA_alcf.yml, the ALCF
# variant of the canonical checkpoints/reFlux/ContextProjectorAlign_JEPA.yml
# (see that file's header for exactly what differs and why: bf16 instead of
# fp32 to fit Polaris' 40GB cards, local eagle dataset path, per-GPU batch
# size of 1 so the 8-way total matches the original recipe's effective batch
# of 8).
#
# Submit from the repo root:
#   qsub scripts/alcf/sjob_ctx_alignA_2node_debug
#
# Override without editing this file:
#   qsub -v OPT=checkpoints/reFlux/ContextProjectorAlign_JEPA_alcf.yml scripts/alcf/sjob_ctx_alignA_2node_debug

set -euo pipefail

OPT="${OPT:-checkpoints/reFlux/ContextProjectorAlign_JEPA_alcf.yml}"
NRANKS_PER_NODE="${NRANKS_PER_NODE:-4}"   # Polaris node = 4x A100 40GB

REPO="${REPO:-/lus/eagle/projects/lighthouse-purdue/harshana/svd_v2}"
cd "${REPO}"
mkdir -p /lus/eagle/projects/lighthouse-purdue/harshana/logs

NNODES=$(wc -l < "${PBS_NODEFILE}")
NTOTRANKS=$(( NNODES * NRANKS_PER_NODE ))
MASTER_ADDR=$(head -n1 "${PBS_NODEFILE}")
MASTER_PORT="${MASTER_PORT:-29500}"

echo "host=$(hostname)  job=${PBS_JOBID:-none}  nnodes=${NNODES}  nranks_per_node=${NRANKS_PER_NODE}  ntotranks=${NTOTRANKS}"
echo "master=${MASTER_ADDR}:${MASTER_PORT}"
echo "nodefile:"
cat "${PBS_NODEFILE}"
echo "repo=${REPO}  opt=${OPT}"

# Compute nodes need the proxy to reach HF / pip / comet.
export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
export HTTPS_PROXY="http://proxy.alcf.anl.gov:3128"
export http_proxy="${HTTP_PROXY}"
export https_proxy="${HTTPS_PROXY}"
export ftp_proxy="${HTTP_PROXY}"
export no_proxy="admin,localhost,*.cm.polaris.alcf.anl.gov,polaris-*,*.polaris.alcf.anl.gov,*.alcf.anl.gov"

export HF_HOME="${REPO}/.cache/huggingface"
export TORCH_HOME="${REPO}/.cache/torch_hub"
export MPICH_GPU_SUPPORT_ENABLED=1

# checkpoints/**/*.yml resolve path.root via ${oc.env:EXPERIMENTS_ROOT,...};
# on ALCF, save experiments/logs under eagle instead of the Gilbreth default.
export EXPERIMENTS_ROOT="${EXPERIMENTS_ROOT:-/lus/eagle/projects/lighthouse-purdue/harshana/logs}"

# No cached FLUX.2-klein-4B / Qwen3-VL-8B-Instruct / V-JEPA hub weights exist
# on ALCF yet (checked eagle + home). First run downloads them over the
# proxy into HF_HOME/TORCH_HOME above -- inside this job's 1h walltime cap.
# If most of the hour disappears into downloads rather than training steps,
# that's expected on this first run, not a launch bug; rerun once cached.

export REPO PROJECT_ENV NNODES NTOTRANKS NRANKS_PER_NODE MASTER_ADDR MASTER_PORT OPT

mpiexec -n "${NNODES}" --ppn 1 --hostfile "${PBS_NODEFILE}" --cpu-bind none \
  bash "${REPO}/scripts/alcf/launch_accelerate_node.sh"
